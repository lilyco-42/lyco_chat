use std::{
    thread,
    time::{self, Duration},
};

use tokio::io;

fn main() {
    // 先写一个简单的假设对话面板这个比较简单.
    //
    const ERROR_READ: &str = "没有值输入";
    println!("请输入对话提示词: ");
    let mut buf = String::new();
    std::io::stdin()
        .read_line(&mut buf)
        .expect("Error:提示词输入失败");

    if buf.trim().is_empty() {
        buf = "没有值输入".to_string()
    }

    println!("hello,i am chatai from lilyco42 {}", buf);
    const BUF_STR: &str = "hello , i am chat ai from lilyco42";
    use tokio::time::{Duration, sleep};
    for i in BUF_STR.chars() {
        print!("{i}");
    }
}
fn time(秒数: u64) {
    tokio::time::sleep(Duration::from_millis(秒数));
}
